{
  "manifest_version": 3,
  "name": "Agent Socket — Connect any site to AI",
  "short_name": "Agent Socket",
  "version": "0.2.0",
  "description": "Let AI chats (Claude, ChatGPT, Gemini) drive your active tab. Paste a session URL; the AI clicks, types, and reads.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "webNavigation",
    "userScripts",
    "notifications",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Agent Socket",
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "32":  "icons/icon-32.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["tools-lib/*.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "connect-slot-1": { "description": "agent-socket: connect slot 1" },
    "connect-slot-2": { "description": "agent-socket: connect slot 2" },
    "connect-slot-3": { "description": "agent-socket: connect slot 3" },
    "connect-slot-4": { "description": "agent-socket: connect slot 4" }
  }
}
