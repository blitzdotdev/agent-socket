{
  "manifest_version": 3,
  "name": "Agent Socket — Connect any site to AI",
  "short_name": "Agent Socket",
  "version": "0.1.0",
  "description": "Let any AI chat (Claude, ChatGPT, Gemini) drive the page you're looking at. Paste a URL into the chat; the AI clicks, types, and reads via tool calls.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Agent Socket",
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "32":  "icons/icon-32.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["tools-lib/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
