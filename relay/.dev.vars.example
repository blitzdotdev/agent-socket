# wrangler dev — local-only env (NEVER shipped to prod).
#
# Copy to relay/.dev.vars (gitignored) before running `bash scripts/deploy.sh dev`
# (the harness passes its own vars). wrangler dev reads this file
# automatically; `wrangler deploy` does NOT (it never sees DEBUG=1).

# Enable /_debug/* endpoints during local dev. MUST be absent in production.
DEBUG=1

# Production default is 30000; short locally so a stalled tool fails fast.
MAX_SYNC_TOOL_MS=3000
