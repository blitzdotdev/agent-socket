{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "agent-socket-relay",
  "main": "src/worker.ts",
  // No account_id: wrangler reads CLOUDFLARE_ACCOUNT_ID (scripts/deploy.sh
  // loads it from .env), or asks after `wrangler login`.
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // The top level has no routes, so a plain `wrangler deploy` publishes to
  // <name>.<your-subdomain>.workers.dev. Add your own route here, or in an env.

  // Landing + privacy pages. Matching paths are served without running the Worker.
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "RelayServer" }
    ]
  },

  // Per-IP cap on /v1/_ws upgrades (each one spawns a session DO). Counted
  // per Cloudflare location. namespace_id must be unique within the account.
  "ratelimits": [
    { "name": "WS_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 100, "period": 10 } }
  ],

  "migrations": [
    { "tag": "v1", "new_classes": ["RelayServer"] }
  ],

  "vars": {
    "MAX_SYNC_TOOL_MS": "30000",
    // App socket silent this long ⇒ closed as dead. The SDK pings every 25 s.
    "HEARTBEAT_TIMEOUT_MS": "50000",
    // A dropped app's session (registration, tokens, async tasks) is held this
    // long so the app can resume it with the same agent URLs. Covers the SDK
    // noticing a dead socket up to ~25 s after the relay does, plus an MV3
    // service worker waiting on its 30 s keepalive alarm. 0 disables resume.
    "RESUME_GRACE_MS": "60000"
    // DEBUG is intentionally not set — production must NOT have it. For local
    // dev, set it in `.dev.vars` (gitignored), which only `wrangler dev` reads.
  },

  "env": {
    // The hosted relay: `bash scripts/deploy.sh deploy` runs
    // `wrangler deploy --env production`. Same Worker name as the top level.
    // Bindings and vars don't inherit into an env in wrangler, so they're
    // repeated here; keep both copies in sync.
    "production": {
      "name": "agent-socket-relay",
      // agentsocket.dev is canonical; aisocket.dev is an alias on the same Worker.
      "routes": [
        { "pattern": "agentsocket.dev",     "custom_domain": true },
        { "pattern": "www.agentsocket.dev", "custom_domain": true },
        { "pattern": "aisocket.dev",        "custom_domain": true },
        { "pattern": "www.aisocket.dev",    "custom_domain": true }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RELAY", "class_name": "RelayServer" }
        ]
      },
      "ratelimits": [
        { "name": "WS_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 100, "period": 10 } }
      ],
      "vars": {
        "MAX_SYNC_TOOL_MS": "30000",
        "HEARTBEAT_TIMEOUT_MS": "50000",
        "RESUME_GRACE_MS": "60000"
      }
    }
  }
}
