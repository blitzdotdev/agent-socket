# Credentials for `bash scripts/deploy.sh deploy`. Copy to `.env` (gitignored).
# Not needed for local dev, tests, the SDK or the extension.
#
# API token: https://dash.cloudflare.com/profile/api-tokens, "Edit Cloudflare
# Workers" template, scoped to your account and the zone(s) in the relay's
# production routes (custom domains need Zone > Workers Routes: Edit).
CLOUDFLARE_API_TOKEN=

# Account ID: Workers & Pages overview in the dashboard, or `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# Optional: space-separated base URLs the post-deploy smoke test checks.
# Default: https://agentsocket.dev https://aisocket.dev
# SMOKE_URLS=https://relay.example.com
